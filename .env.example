# ==============================================================
# School Event Attendance System - Environment Configuration
# Copy this file to `.env` and adjust values. NEVER commit .env.
# ==============================================================

# --- Server ---
PORT=3000
# development | production. In production: secure cookies required,
# SESSION_SECRET must be set, and the app must be served over HTTPS.
NODE_ENV=development
# Comma-separated list of trusted proxies (for req.ip behind nginx etc).
# Leave empty for direct deployment. Use `loopback` for local reverse proxies.
TRUST_PROXY=

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=school_attendance
DB_CONNECTION_LIMIT=10

# --- Sessions & Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production. In development a random ephemeral secret is used if unset.
SESSION_SECRET=
# Session lifetime in minutes (idle timeout). Default 120.
SESSION_TTL_MINUTES=120
# Set to true when serving over HTTPS (production). Forces Secure cookies.
COOKIE_SECURE=false
# SameSite policy for the session cookie: Lax (default) | Strict
COOKIE_SAMESITE=Lax

# --- Rate limiting (attempts per window) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_ATTENDANCE_MAX=20
RATE_LIMIT_ATTENDANCE_WINDOW_MINUTES=1
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MINUTES=1
# Login lockout: failed attempts before temporary lock, and lock duration in minutes
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- QR / GPS defaults (can be overridden per event or in system settings) ---
QR_ROTATION_SECONDS=45
GPS_DEFAULT_RADIUS_METERS=50
GPS_MAX_ACCURACY_METERS=50
GPS_FRESHNESS_SECONDS=60
GPS_FLAG_DISTANCE_MULTIPLIER=1.5

# --- School ---
SCHOOL_TIMEZONE=Asia/Manila
SCHOOL_NAME=Sample Junior-Senior High School

# --- Seed script (development only) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_STUDENTS_PER_SECTION=8

# --- Email (optional; SMTP) ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="School Attendance System <no-reply@example.edu>"

# --- Web Push (optional). Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.edu

# --- Logging ---
LOG_LEVEL=info
